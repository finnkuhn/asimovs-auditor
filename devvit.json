{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "asimovs-auditor",
  "blocks": {
    "entry": "src/main.ts",
    "triggers": ["onPostSubmit", "onCommentSubmit"],
    "menu": { "enable": false },
    "forms": { "enable": false },
    "settings": { "enable": false }
  },
  "scheduler": {
    "tasks": {
      "scheduler_enable_placeholder": {
        "endpoint": "/internal/scheduler/unused"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true
    },
    "http": {
      "enable": true,
      "domains": ["api.github.com"]
    }
  }
}
